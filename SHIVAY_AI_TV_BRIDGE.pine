//@version=6
indicator(
     "SHIVAY AI TradingView Alert Bridge",
     overlay = true,
     max_bars_back = 500
)

// =====================================================
// HELPER FUNCTION
// Must be declared without a return type before its name.
// =====================================================
toJsonNumber(float value) =>
    na(value) ? "null" : str.tostring(value, format.mintick)

// =====================================================
// USER SETTINGS
// =====================================================
string sharedSecret = input.string(
     "",
     "Webhook shared secret",
     confirm = true
)

string instrumentName = input.string(
     "USER_SELECTED_CONTRACT",
     "Configured instrument name",
     confirm = true
)

string instrumentCategory = input.string(
     "USER_SELECTED_CATEGORY",
     "Instrument category",
     confirm = true
)

string contractText = input.string(
     "USER_VERIFIED_CONTRACT",
     "Contract text",
     confirm = true
)

int atrPeriod = input.int(
     7,
     "Chandelier ATR period",
     minval = 2
)

float atrMultiplier = input.float(
     2.0,
     "Chandelier ATR multiplier",
     minval = 0.1,
     step = 0.1
)

// =====================================================
// INDICATORS
// =====================================================
float ema20 = ta.ema(close, 20)
float ema50 = ta.ema(close, 50)
float ema200 = ta.ema(close, 200)

float currentVwap = ta.vwap(hlc3)
float currentRsi = ta.rsi(close, 14)

[plusDI, minusDI, currentAdx] = ta.dmi(14, 14)
[macdValue, macdSignal, macdHistogram] = ta.macd(close, 12, 26, 9)

float currentAtr = ta.atr(atrPeriod)
float averageVolume = ta.sma(volume, 20)

float relativeVolume =
     not na(averageVolume) and averageVolume > 0
     ? volume / averageVolume
     : na

// =====================================================
// CHANDELIER EXIT
// =====================================================
float chandelierLong =
     ta.highest(high, atrPeriod) -
     currentAtr * atrMultiplier

float chandelierShort =
     ta.lowest(low, atrPeriod) +
     currentAtr * atrMultiplier

var int chandelierState = 0

chandelierState :=
     close > nz(chandelierShort[1], chandelierShort)
     ? 1
     : close < nz(chandelierLong[1], chandelierLong)
     ? -1
     : nz(chandelierState[1], 0)

string chandelierDirection =
     chandelierState == 1
     ? "BULLISH"
     : chandelierState == -1
     ? "BEARISH"
     : "SIDEWAYS"

// =====================================================
// STRUCTURE
// =====================================================
float swingHigh = ta.highest(high[1], 20)
float swingLow = ta.lowest(low[1], 20)

float previousClose = request.security(
     syminfo.tickerid,
     "D",
     close[1],
     lookahead = barmerge.lookahead_off
)

float currentDayOpen = request.security(
     syminfo.tickerid,
     "D",
     open,
     lookahead = barmerge.lookahead_off
)

float currentDayHigh = request.security(
     syminfo.tickerid,
     "D",
     high,
     lookahead = barmerge.lookahead_off
)

float currentDayLow = request.security(
     syminfo.tickerid,
     "D",
     low,
     lookahead = barmerge.lookahead_off
)

float previousDayHigh = request.security(
     syminfo.tickerid,
     "D",
     high[1],
     lookahead = barmerge.lookahead_off
)

float previousDayLow = request.security(
     syminfo.tickerid,
     "D",
     low[1],
     lookahead = barmerge.lookahead_off
)

// =====================================================
// SUPERTREND
// =====================================================
[supertrendValue, supertrendCode] = ta.supertrend(3.0, 10)

string supertrendDirection =
     supertrendCode < 0
     ? "BULLISH"
     : "BEARISH"

// =====================================================
// MARKET STRUCTURE FLAGS
// =====================================================
bool higherHigh =
     not na(swingHigh) and
     not na(swingHigh[1]) and
     swingHigh > swingHigh[1]

bool higherLow =
     not na(swingLow) and
     not na(swingLow[1]) and
     swingLow > swingLow[1]

bool lowerHigh =
     not na(swingHigh) and
     not na(swingHigh[1]) and
     swingHigh < swingHigh[1]

bool lowerLow =
     not na(swingLow) and
     not na(swingLow[1]) and
     swingLow < swingLow[1]

bool breakoutStatus =
     not na(swingHigh) and
     close > swingHigh

bool breakdownStatus =
     not na(swingLow) and
     close < swingLow

bool bullishRetest =
     not na(swingHigh) and
     low <= swingHigh and
     close > swingHigh

bool bearishRetest =
     not na(swingLow) and
     high >= swingLow and
     close < swingLow

bool bullishPullback =
     not na(currentAtr) and
     math.abs(close - ema20) <= currentAtr and
     close > ema20 and
     ema20 > ema50

bool bearishPullback =
     not na(currentAtr) and
     math.abs(close - ema20) <= currentAtr and
     close < ema20 and
     ema20 < ema50

bool retestStatus =
     bullishRetest or bearishRetest

bool pullbackStatus =
     bullishPullback or bearishPullback

bool chandelierChanged =
     chandelierState != nz(chandelierState[1], 0)

// =====================================================
// TREND AND MOMENTUM
// =====================================================
string trendState =
     ema20 > ema50 and ema50 > ema200
     ? "BULLISH"
     : ema20 < ema50 and ema50 < ema200
     ? "BEARISH"
     : "SIDEWAYS"

string momentumState =
     macdHistogram > 0 and currentRsi > 50
     ? "BULLISH"
     : macdHistogram < 0 and currentRsi < 50
     ? "BEARISH"
     : "NEUTRAL"

bool volumeConfirmed =
     not na(relativeVolume) and
     relativeVolume >= 1.0

// =====================================================
// PRELIMINARY SIGNALS
// =====================================================
bool preliminaryBuy =
     trendState == "BULLISH" and
     chandelierDirection == "BULLISH" and
     supertrendDirection == "BULLISH" and
     momentumState == "BULLISH" and
     (
         breakoutStatus or
         bullishRetest or
         bullishPullback
     )

bool preliminarySell =
     trendState == "BEARISH" and
     chandelierDirection == "BEARISH" and
     supertrendDirection == "BEARISH" and
     momentumState == "BEARISH" and
     (
         breakdownStatus or
         bearishRetest or
         bearishPullback
     )

bool setupValid =
     (preliminaryBuy or preliminarySell) and
     currentAdx >= 18 and
     currentRsi > 22 and
     currentRsi < 78

// =====================================================
// ALERT VALIDATION
// =====================================================
bool supportedTimeframe =
     timeframe.period == "1" or
     timeframe.period == "5" or
     timeframe.period == "15" or
     timeframe.period == "30" or
     timeframe.period == "60"

bool valuesReady =
     not na(ema200) and
     not na(currentVwap) and
     not na(currentAdx) and
     not na(currentAtr) and
     not na(relativeVolume) and
     not na(swingHigh) and
     not na(swingLow) and
     not na(previousClose)

bool secretReady =
     str.length(sharedSecret) >= 24

bool alertSignal =
     barstate.isrealtime and
     barstate.isconfirmed and
     supportedTimeframe and
     valuesReady and
     secretReady

// =====================================================
// WEBHOOK JSON ALERT
// =====================================================
if alertSignal
    string eventId =
         syminfo.tickerid +
         "-" +
         timeframe.period +
         "-" +
         str.tostring(time)

    string message =
         "{" +
         "\"secret\":\"" + sharedSecret + "\"," +
         "\"source\":\"TRADINGVIEW_PINE_BRIDGE\"," +
         "\"event_id\":\"" + eventId + "\"," +
         "\"event_type\":\"timeframe_update\"," +
         "\"script_version\":\"2026.08.2\"," +

         "\"symbol\":\"" + syminfo.tickerid + "\"," +
         "\"ticker_id\":\"" + syminfo.tickerid + "\"," +
         "\"exchange\":\"" + syminfo.prefix + "\"," +

         "\"instrument\":\"" + instrumentName + "\"," +
         "\"category\":\"" + instrumentCategory + "\"," +
         "\"contract_text\":\"" + contractText + "\"," +

         "\"timeframe\":\"" + timeframe.period + "\"," +

         "\"open\":" + toJsonNumber(open) + "," +
         "\"high\":" + toJsonNumber(high) + "," +
         "\"low\":" + toJsonNumber(low) + "," +
         "\"close\":" + toJsonNumber(close) + "," +
         "\"volume\":" + toJsonNumber(volume) + "," +

         "\"previous_close\":" + toJsonNumber(previousClose) + "," +
         "\"day_open\":" + toJsonNumber(currentDayOpen) + "," +
         "\"day_high\":" + toJsonNumber(currentDayHigh) + "," +
         "\"day_low\":" + toJsonNumber(currentDayLow) + "," +
         "\"previous_day_high\":" + toJsonNumber(previousDayHigh) + "," +
         "\"previous_day_low\":" + toJsonNumber(previousDayLow) + "," +

         "\"ema20\":" + toJsonNumber(ema20) + "," +
         "\"ema50\":" + toJsonNumber(ema50) + "," +
         "\"ema200\":" + toJsonNumber(ema200) + "," +
         "\"vwap\":" + toJsonNumber(currentVwap) + "," +

         "\"rsi\":" + toJsonNumber(currentRsi) + "," +
         "\"adx\":" + toJsonNumber(currentAdx) + "," +
         "\"plus_di\":" + toJsonNumber(plusDI) + "," +
         "\"minus_di\":" + toJsonNumber(minusDI) + "," +

         "\"macd\":" + toJsonNumber(macdValue) + "," +
         "\"macd_signal\":" + toJsonNumber(macdSignal) + "," +
         "\"macd_histogram\":" + toJsonNumber(macdHistogram) + "," +

         "\"atr\":" + toJsonNumber(currentAtr) + "," +
         "\"relative_volume\":" + toJsonNumber(relativeVolume) + "," +

         "\"chandelier_long_stop\":" + toJsonNumber(chandelierLong) + "," +
         "\"chandelier_short_stop\":" + toJsonNumber(chandelierShort) + "," +
         "\"chandelier_direction\":\"" + chandelierDirection + "\"," +

         "\"supertrend_value\":" + toJsonNumber(supertrendValue) + "," +
         "\"supertrend_direction\":\"" + supertrendDirection + "\"," +

         "\"trend_state\":\"" + trendState + "\"," +
         "\"momentum_state\":\"" + momentumState + "\"," +

         "\"swing_high\":" + toJsonNumber(swingHigh) + "," +
         "\"swing_low\":" + toJsonNumber(swingLow) + "," +
         "\"breakout_level\":" + toJsonNumber(swingHigh) + "," +
         "\"breakdown_level\":" + toJsonNumber(swingLow) + "," +

         "\"signal_candle_high\":" + toJsonNumber(high) + "," +
         "\"signal_candle_low\":" + toJsonNumber(low) + "," +

         "\"higher_high\":" + str.tostring(higherHigh) + "," +
         "\"higher_low\":" + str.tostring(higherLow) + "," +
         "\"lower_high\":" + str.tostring(lowerHigh) + "," +
         "\"lower_low\":" + str.tostring(lowerLow) + "," +

         "\"breakout\":" + str.tostring(breakoutStatus) + "," +
         "\"breakdown\":" + str.tostring(breakdownStatus) + "," +
         "\"bullish_breakout\":" + str.tostring(breakoutStatus) + "," +
         "\"bearish_breakdown\":" + str.tostring(breakdownStatus) + "," +

         "\"bullish_retest\":" + str.tostring(bullishRetest) + "," +
         "\"bearish_retest\":" + str.tostring(bearishRetest) + "," +
         "\"retest\":" + str.tostring(retestStatus) + "," +

         "\"bullish_pullback\":" + str.tostring(bullishPullback) + "," +
         "\"bearish_pullback\":" + str.tostring(bearishPullback) + "," +
         "\"pullback\":" + str.tostring(pullbackStatus) + "," +

         "\"chandelier_direction_changed\":" +
         str.tostring(chandelierChanged) + "," +

         "\"preliminary_buy\":" +
         str.tostring(preliminaryBuy) + "," +

         "\"preliminary_sell\":" +
         str.tostring(preliminarySell) + "," +

         "\"volume_confirmed\":" +
         str.tostring(volumeConfirmed) + "," +

         "\"setup_valid\":" +
         str.tostring(setupValid) + "," +

         "\"bar_timestamp\":" + str.tostring(time) + "," +
         "\"generated_at\":" + str.tostring(timenow) + "," +
         "\"bar_confirmed\":true" +
         "}"

    alert(message, alert.freq_once_per_bar_close)

// =====================================================
// VISUAL CHANDELIER LINES
// =====================================================
plot(
     chandelierState == 1 ? chandelierLong : na,
     title = "Chandelier Long",
     color = color.green,
     style = plot.style_linebr
)

plot(
     chandelierState == -1 ? chandelierShort : na,
     title = "Chandelier Short",
     color = color.red,
     style = plot.style_linebr
)
