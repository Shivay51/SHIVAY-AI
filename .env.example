# Telegram
BOT_TOKEN=
CHAT_ID=
ADMIN_ID=

# Preferred official Groww read-only data adapter (requires active Groww API subscription)
ENABLE_GROWW=false
GROWW_ACCESS_TOKEN=

# Temporary read-only public-data adapters; replace with Groww when activated
ENABLE_NSE_TEMPORARY=true
ENABLE_MCX_TEMPORARY=true

# Shoonya / Finvasia preferred read-only Indian market data
ENABLE_SHOONYA=true
SHOONYA_USER_ID=
SHOONYA_PASSWORD=
SHOONYA_VENDOR_CODE=
SHOONYA_API_KEY=
SHOONYA_IMEI=
SHOONYA_TOTP_SECRET=
# Optional alternatives: current OTP or an already-issued session token
SHOONYA_TWO_FA=
SHOONYA_SESSION_TOKEN=

# Preferred official Upstox read-only Indian market data (requires an Upstox account/app)
ENABLE_UPSTOX=false
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=
UPSTOX_ACCESS_TOKEN=

# DhanHQ primary live market data (requires an active Dhan Data API plan)
ENABLE_DHAN=true
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# TrueData official market-data trial (credentials supplied by TrueData)
ENABLE_TRUEDATA=false
TRUEDATA_USERNAME=
TRUEDATA_PASSWORD=
TRUEDATA_API_KEY=
TRUEDATA_WEBSOCKET_URL=
TRUEDATA_TRIAL_EXPIRES_AT=

# Global Datafeeds official market-data trial (endpoint/key supplied by GDFL)
ENABLE_GDFL=false
GDFL_API_KEY=
GDFL_ENDPOINT=
GDFL_PORT=
GDFL_USERNAME=
GDFL_PASSWORD=
GDFL_TRIAL_EXPIRES_AT=

# TradingView official alert/webhook bridge (exact symbols must be user verified)
WEB_SERVER_ENABLED=
WEB_SERVER_HOST=127.0.0.1
WEB_SERVER_PORT=8765
TRADINGVIEW_PUBLIC_BASE_URL=https://app.vanraj.co.in
TRADINGVIEW_WEBHOOK_ENABLED=true
TRADINGVIEW_WEBHOOK_SECRET=
TRADINGVIEW_WEBHOOK_PATH=/tradingview-webhook
TRADINGVIEW_WEBHOOK_HOST=127.0.0.1
TRADINGVIEW_WEBHOOK_PORT=8765
TRADINGVIEW_MAX_DELAY_SECONDS=120
TRADINGVIEW_MAX_REQUEST_BYTES=32768
TRADINGVIEW_REQUIRE_HTTPS=true
TRADINGVIEW_ALLOWED_SYMBOLS=
TRADINGVIEW_ALLOWED_TIMEFRAMES=1,5,15,30,60
TRADINGVIEW_ALLOWED_CATEGORIES=NSE_FO,MCX,CONTEXT,GIFT,GLOBAL_CONTEXT
TRADINGVIEW_CANDLE_STORE=C:\SHIVAY_AI\storage\tradingview_candles.json
TRADINGVIEW_REPLAY_STORE=C:\SHIVAY_AI\storage\tradingview_replay.json
TRADINGVIEW_SYMBOL_MAP_FILE=C:\SHIVAY_AI\tradingview_symbols.json
TRADINGVIEW_NIFTY_FUT_SYMBOL=
TRADINGVIEW_BANKNIFTY_FUT_SYMBOL=
TRADINGVIEW_GIFT_NIFTY_SYMBOL=
TRADINGVIEW_MCX_GOLD_SYMBOL=
TRADINGVIEW_MCX_SILVER_SYMBOL=
TRADINGVIEW_COMEX_GOLD_SYMBOL=
TRADINGVIEW_COMEX_SILVER_SYMBOL=
TRADINGVIEW_STOCK_FUTURES_SYMBOLS=

# Authenticated Market Hub account integration
ENABLE_MARKET_HUB=true
TRADEX_APP_KEY=
TRADEX_SECRET_KEY=
TRADEX_BASE_URL=https://tradex.markethubonline.com:30001/TradeXApi/v1
TRADEX_CLIENT_ID=
TRADEX_USER_ID=

# Safety
ENABLE_LIVE_ORDER_PLACEMENT=false
PAPER_TRADING=true
SIGNALS_ONLY=true
PAPER_MONITORING=true
MIN_RISK_REWARD=2.0
CHANDELIER_ATR_PERIOD=7
CHANDELIER_ATR_MULTIPLIER=2.0
CHANDELIER_CONFIRMATION_SECONDS=60
ENTRY_CONFIRMATION_CANDLES=1
ENTRY_BREAK_BUFFER_ATR=0.05
SIGNAL_MAX_AGE_CANDLES=2
PROVIDER_PRIORITY=angelone_primary,tradingview_alert_bridge
ENABLE_RECOVERY_ALERTS=false
ALLOW_YAHOO_FALLBACK=true

# ---------------------------------------------------------------------------
# ANGEL ONE SMARTAPI (RUNTIME PRIMARY MARKET-DATA PROVIDER, READ-ONLY)
# ---------------------------------------------------------------------------
# Required for live data. Create an API key at https://smartapi.angelone.in/
# ANGEL_TOTP_SECRET is the base32 secret shown when you enable TOTP; SHIVAY AI
# generates a fresh 6-digit code automatically on every login, so you never
# paste a code manually. Never commit real values.
ANGEL_API_KEY=your_angel_api_key
ANGEL_CLIENT_ID=your_angel_client_code
ANGEL_PIN=your_angel_pin
ANGEL_TOTP_SECRET=your_angel_base32_totp_secret
# Optional request-header metadata accepted by Angel SmartAPI.
ANGEL_LOCAL_IP=127.0.0.1
ANGEL_PUBLIC_IP=127.0.0.1
ANGEL_MAC_ADDRESS=00:00:00:00:00:00
ANGEL_INSTRUMENT_TIMEOUT=30

# ==========================================
# SIGNAL PROTECTIONS
# ==========================================
# Minutes a symbol is blocked from re-signalling after a delivered signal.
SIGNAL_REPEAT_COOLDOWN_MINUTES=45
